#!/usr/bin/env bash
# fzf popup picker for all tmux windows across all sessions.
# --status mode: print tmux status bar dot summary instead of launching picker.
set -uo pipefail

SELF=$(realpath "$0")

set_state() {
  local state="$1"
  [ -z "${TMUX_PANE:-}" ] && return 0
  tmux set-option -wt "$TMUX_PANE" @window_state "$state"
  tmux set-option -wt "$TMUX_PANE" @window_state_at "$(date +%s)"
  if [ "$state" = "waiting" ]; then
    {
      local f
      f=$(ls ~/wow/*.wav 2>/dev/null | shuf -n1)
      if [ -n "$f" ]; then
        afplay "$f"
      elif command -v fortune &>/dev/null; then
        fortune -s | say
      else
        say "Please configure your notifications"
      fi
    } &
  fi
}

# Resolve effective state for a window.
# Windows with @window_state set use that value; if claude exited (pane reverted
# to shell) treat as idle. Windows without @window_state fall back to
# pane_current_command: shell = idle, anything else = working.
resolve_state() {
  local window_state="$1" cmd="$2"
  if [ -n "$window_state" ]; then
    case "$cmd" in
      bash|zsh|sh|fish|'') printf 'idle' ;;
      *)                   printf '%s' "$window_state" ;;
    esac
    return
  fi
  case "$cmd" in
    bash|zsh|sh|fish|claude|'') printf 'idle' ;;
    *)                          printf 'working' ;;
  esac
}

emit_rows() {
  local now
  now=$(date +%s)
  tmux list-windows -a -F '#{session_name}:#{window_index}|#{window_name}|#{pane_current_path}|#{@window_state}|#{pane_current_command}' \
  | while IFS='|' read -r target name path window_state cmd; do
      state=$(resolve_state "$window_state" "$cmd")
      at=$(tmux show-options -qvw -t "$target" @window_state_at 2>/dev/null)
      case "$state" in
        waiting) icon=$'\033[31m●\033[0m waiting' rank=0 ;;
        working) icon=$'\033[33m●\033[0m working' rank=1 ;;
        *)       icon=$'\033[32m●\033[0m idle   ' rank=2 ;;
      esac
      if [ -n "$at" ]; then ago="$(( (now - at) / 60 ))m"; else ago=''; fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$rank" "$target" "$icon" "$name" "${path/#$HOME/~}" "$ago"
    done \
  | sort -n
}

status_dots() {
  local idle=0 waiting=0 working=0
  while IFS='|' read -r target name path window_state cmd; do
    state=$(resolve_state "$window_state" "$cmd")
    case "$state" in
      idle)    idle=$((idle + 1)) ;;
      waiting) waiting=$((waiting + 1)) ;;
      working) working=$((working + 1)) ;;
    esac
  done < <(tmux list-windows -a -F '#{session_name}:#{window_index}|#{window_name}|#{pane_current_path}|#{@window_state}|#{pane_current_command}')

  local out=""
  [ "$idle"    -gt 0 ] && out="${out}#[fg=#7F9F7F]● ${idle}#[default] "
  [ "$waiting" -gt 0 ] && out="${out}#[fg=#CC9393]● ${waiting}#[default] "
  [ "$working" -gt 0 ] && out="${out}#[fg=#F0DFAF]● ${working}#[default]"
  printf '%s' "${out% }"
}

case "${1:-}" in
  --status)    status_dots;    exit 0 ;;
  --rows)      emit_rows;      exit 0 ;;
  --set-state) set_state "$2"; exit 0 ;;
esac

sel=$(emit_rows | fzf --ansi --delimiter=$'\t' --with-nth=3,4,5,6 \
  --reverse --cycle \
  --header='windows · enter: jump · ctrl-x: kill' \
  --preview='tmux capture-pane -ept {2}' \
  --preview-window='right,62%,wrap' \
  --bind="ctrl-x:execute-silent(tmux kill-window -t {2})+reload($SELF --rows)")

[ -z "$sel" ] && exit 0
target=$(printf '%s' "$sel" | cut -f2)
tmux switch-client -t "$target"
