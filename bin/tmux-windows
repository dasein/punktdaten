#!/usr/bin/env bash
# fzf popup picker for all tmux windows across all sessions.
# --status mode: print tmux status bar dot summary instead of launching picker.
set -uo pipefail

SELF=$(realpath "$0")

DAEMON_PID_OPTION="@tmux_windows_daemon_pid"
DAEMON_POLL_INTERVAL=1
DAEMON_DEBOUNCE_POLLS=2

set_state() {
  local state="$1"
  [ -z "${TMUX_PANE:-}" ] && return 0
  set_window_state "$TMUX_PANE" "$state"
}

# Write a window's state and, on a transition into "waiting", play the sound.
# `target` is anything tmux accepts as a -t target (a pane or window id).
set_window_state() {
  local target="$1" state="$2"
  tmux set-option -wt "$target" @window_state "$state"
  tmux set-option -wt "$target" @window_state_at "$(date +%s)"
  if [ "$state" = "waiting" ]; then
    play_waiting_sound &
  fi
}

play_waiting_sound() {
  local f
  f=$(ls ~/wow/*.wav 2>/dev/null | shuf -n1)
  if [ -n "$f" ]; then
    afplay "$f"
  elif command -v fortune &>/dev/null; then
    fortune -s | say
  else
    say "Please configure your notifications"
  fi
}

# True if a pane's current command names a Claude process. Claude's native
# installer runs a versioned binary and tmux reports that bare semver
# (e.g. 2.1.197) as the command instead of "claude" (anthropics/claude-code#49852).
is_claude() {
  local cmd="$1"
  case "$cmd" in
    claude|claude-code) return 0 ;;
  esac
  [[ "$cmd" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

is_codex() {
  [ "$1" = codex ]
}

is_agent() {
  is_claude "$1" || is_codex "$1"
}

# True if an OSC pane title starts with a braille spinner glyph, which both
# Claude and Codex set while a turn is running.
title_has_spinner() {
  local LC_ALL=C
  case "$1" in
    $'\xe2\xa0'*|$'\xe2\xa1'*|$'\xe2\xa2'*|$'\xe2\xa3'*) return 0 ;;
  esac
  return 1
}

# Detect Codex's state for a pane from its OSC title alone: a braille spinner
# prefix means working; "Action Required" (shown for approval prompts) means
# waiting; otherwise idle.
detect_codex_state() {
  local title
  title=$(tmux display-message -pt "$1" '#{pane_title}')
  if title_has_spinner "$title"; then
    printf 'working'
  elif [[ "$title" == *"Action Required"* ]]; then
    printf 'waiting'
  else
    printf 'idle'
  fi
}

detect_state() {
  local pane_id="$1" cmd="$2"
  if is_codex "$cmd"; then
    detect_codex_state "$pane_id"
  else
    detect_claude_state "$pane_id"
  fi
}

# Detect Claude's state for a pane by reading its OSC title and recent screen
# text, passively (no hooks): braille spinner prefix on the title means
# working; a selection menu (cursor resting on a numbered option, or the
# "enter to select"/"esc to cancel" phrase pair) means waiting; otherwise idle.
detect_claude_state() {
  local pane_id="$1"
  local title recent
  title=$(tmux display-message -pt "$pane_id" '#{pane_title}')
  recent=$(tmux capture-pane -pJ -t "$pane_id" -S -25 2>/dev/null)

  local LC_ALL=C
  if title_has_spinner "$title"; then
    printf 'working'; return
  fi

  if has_selection_prompt "$recent"; then
    printf 'waiting'; return
  fi
  local recent_lower
  recent_lower=$(printf '%s' "$recent" | tr '[:upper:]' '[:lower:]')
  if [[ "$recent_lower" == *"enter to select"* && "$recent_lower" == *"esc to cancel"* ]]; then
    printf 'waiting'; return
  fi

  printf 'idle'
}

# True if the recent screen text shows a Claude selection menu: the cursor
# (❯) rests on a numbered option AND at least one other numbered option is
# present. Requiring a second option distinguishes a real menu from the bare
# ❯ input box. Leading whitespace and box-drawing borders are stripped so it
# matches Claude's bordered rendering too.
has_selection_prompt() {
  local text="$1"
  local cursor_on_option=0 option_lines=0
  local line stripped rest
  while IFS= read -r line; do
    stripped="${line#"${line%%[![:space:]│┃║╎┆┊|]*}"}"
    if [[ "$stripped" == $'❯'* ]]; then
      rest="${stripped#$'❯'}"
      rest="${rest# }"
      has_cursor=1
    else
      rest="$stripped"
      has_cursor=0
    fi
    local option_re='^[0-9]+[.)]'
    if [[ "$rest" =~ $option_re ]]; then
      option_lines=$((option_lines + 1))
      [[ "$has_cursor" == 1 ]] && cursor_on_option=1
    fi
  done <<< "$text"
  [[ "$cursor_on_option" == 1 && "$option_lines" -ge 2 ]]
}

declare -A DAEMON_COMMITTED DAEMON_CANDIDATE DAEMON_COUNT

# Claims ownership of the background poller by writing our pid to a global
# tmux option. Returns failure if another live process already holds it, so
# a second "--daemon" invocation (e.g. a tmux.conf reload) is a no-op.
claim_daemon() {
  local existing_pid
  existing_pid=$(tmux show-options -gqv "$DAEMON_PID_OPTION" 2>/dev/null)
  if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
    return 1
  fi
  tmux set-option -gq "$DAEMON_PID_OPTION" "$$"
}

# Polls every window's active pane once, debounces a state change over
# DAEMON_DEBOUNCE_POLLS consecutive polls (in either direction) before
# committing it, and plays the waiting sound only on a freshly committed
# transition into "waiting".
poll_agent_state_once() {
  local -A live=()
  local window_id pane_id cmd active attached raw prev
  while IFS='|' read -r window_id pane_id cmd active attached; do
    [ -z "$window_id" ] && continue
    is_agent "$cmd" || continue
    live[$window_id]=1

    if [ "$active" = '1' ] && [ "$attached" = '1' ]; then
      tmux set-option -wt "$window_id" @window_seen 1
    fi

    if [ -z "${DAEMON_COMMITTED[$window_id]+x}" ]; then
      DAEMON_COMMITTED[$window_id]=$(tmux show-options -qvw -t "$window_id" @window_state 2>/dev/null)
      [ -z "${DAEMON_COMMITTED[$window_id]}" ] && DAEMON_COMMITTED[$window_id]='idle'
    fi
    prev="${DAEMON_COMMITTED[$window_id]}"
    raw=$(detect_state "$pane_id" "$cmd")

    if [ "$raw" = "$prev" ]; then
      DAEMON_CANDIDATE[$window_id]="$raw"
      DAEMON_COUNT[$window_id]=0
      continue
    fi

    if [ "${DAEMON_CANDIDATE[$window_id]:-}" = "$raw" ]; then
      DAEMON_COUNT[$window_id]=$(( DAEMON_COUNT[$window_id] + 1 ))
    else
      DAEMON_CANDIDATE[$window_id]="$raw"
      DAEMON_COUNT[$window_id]=1
    fi

    if [ "${DAEMON_COUNT[$window_id]}" -ge "$DAEMON_DEBOUNCE_POLLS" ]; then
      DAEMON_COMMITTED[$window_id]="$raw"
      DAEMON_COUNT[$window_id]=0
      set_window_state "$window_id" "$raw"
      if [ "$raw" = 'idle' ] && [ "$prev" != 'idle' ] && { [ "$active" != '1' ] || [ "$attached" != '1' ]; }; then
        tmux set-option -wt "$window_id" @window_seen 0
      fi
    fi
  done < <(tmux list-windows -a -F '#{window_id}|#{pane_id}|#{pane_current_command}|#{window_active}|#{session_attached}')

  local wid
  for wid in "${!DAEMON_COMMITTED[@]}"; do
    if [ -z "${live[$wid]:-}" ]; then
      unset 'DAEMON_COMMITTED[$wid]' 'DAEMON_CANDIDATE[$wid]' 'DAEMON_COUNT[$wid]'
    fi
  done
}

run_daemon() {
  while true; do
    [ "$(tmux show-options -gqv "$DAEMON_PID_OPTION" 2>/dev/null)" = "$$" ] || break
    poll_agent_state_once
    sleep "$DAEMON_POLL_INTERVAL"
  done
}

# Resolve effective state for a window: idle for a shell (including an agent
# pane that has exited back to one), the daemon-maintained @window_state for
# a live Claude or Codex pane, or empty for anything else we have no real
# detection for — an unrecognized command is left untracked rather than
# assumed "working".
resolve_state() {
  local window_state="$1" cmd="$2"
  case "$cmd" in
    bash|zsh|sh|fish|'') printf 'idle' ;;
    *)
      if is_agent "$cmd"; then
        printf '%s' "${window_state:-idle}"
      fi
      ;;
  esac
}

NAME_WIDTH=30

# Pad or truncate a window name to a fixed display width so the picker's
# name column lines up regardless of how long the name is.
format_name() {
  local name="$1"
  if [ "${#name}" -gt "$NAME_WIDTH" ]; then
    printf '%s…' "${name:0:$((NAME_WIDTH - 1))}"
  else
    printf '%s%*s' "$name" "$((NAME_WIDTH - ${#name}))" ''
  fi
}

emit_rows() {
  local now
  now=$(date +%s)
  tmux list-windows -a -F '#{session_name}:#{window_index}|#{window_index}|#{window_name}|#{pane_current_path}|#{@window_state}|#{pane_current_command}|#{@window_seen}' \
  | while IFS='|' read -r target index name path window_state cmd seen; do
      state=$(resolve_state "$window_state" "$cmd")
      at=$(tmux show-options -qvw -t "$target" @window_state_at 2>/dev/null)
      case "$state" in
        waiting) icon=$'\033[31m●\033[0m' label='waiting' ;;
        working) icon=$'\033[33m●\033[0m' label='working' ;;
        idle)    if [ "$seen" = '0' ]; then icon=$'\033[36m●\033[0m'; label='idle/unseen'; else icon=$'\033[32m✓\033[0m'; label='idle/seen'; fi ;;
        *)       icon=' '                  label=''         ;;
      esac
      if [ -n "$at" ]; then ago="$(( (now - at) / 60 ))m"; else ago=''; fi
      display=$(printf '%2s  %s  %s' "$index" "$icon" "$(format_name "$name")")
      printf '%s\t%s\t%s\t%s\t%s\n' "$target" "$display" "${path/#$HOME/~}" "$ago" "$label"
    done
}

# Preview pane content for the picker: full path (and last-update age, if
# any) as a header, followed by just enough of the tail of the window's live
# pane content to fill fzf's preview pane, so it always shows the tail
# without needing to scroll.
preview_pane() {
  local target="$1" path="$2" ago="$3"
  if [ -n "$ago" ]; then
    printf '%s · updated %s ago\n\n' "$path" "$ago"
  else
    printf '%s\n\n' "$path"
  fi
  tmux capture-pane -ept "$target" | tail -n "$(( ${FZF_PREVIEW_LINES:-27} - 2 ))"
}

status_dots() {
  local idle=0 waiting=0 working=0
  while IFS='|' read -r target name path window_state cmd; do
    state=$(resolve_state "$window_state" "$cmd")
    case "$state" in
      idle)    idle=$((idle + 1)) ;;
      waiting) waiting=$((waiting + 1)) ;;
      working) working=$((working + 1)) ;;
    esac
  done < <(tmux list-windows -a -F '#{session_name}:#{window_index}|#{window_name}|#{pane_current_path}|#{@window_state}|#{pane_current_command}')

  local out=""
  [ "$idle"    -gt 0 ] && out="${out}#[fg=#7F9F7F]● ${idle}#[default] "
  [ "$waiting" -gt 0 ] && out="${out}#[fg=#CC9393]● ${waiting}#[default] "
  [ "$working" -gt 0 ] && out="${out}#[fg=#F0DFAF]● ${working}#[default]"
  printf '%s' "${out% }"
}

case "${1:-}" in
  --status)       status_dots;    exit 0 ;;
  --rows)         emit_rows;      exit 0 ;;
  --set-state)    set_state "$2"; exit 0 ;;
  --daemon)       claim_daemon && run_daemon; exit 0 ;;
  --preview)      preview_pane "$2" "$3" "$4"; exit 0 ;;
esac

sel=$(emit_rows | fzf --ansi --delimiter=$'\t' --with-nth=2 --nth=2,5 \
  --reverse --cycle \
  --header=$'\033[31m●\033[0m waiting  \033[33m●\033[0m working  \033[32m✓\033[0m idle/seen  \033[36m●\033[0m idle/unseen' \
  --footer='enter: jump · ctrl-x: kill' \
  --preview="$SELF --preview {1} {3} {4}" \
  --preview-window='down,80%,wrap' \
  --bind="ctrl-x:execute-silent(tmux kill-window -t {1})+reload($SELF --rows)")

[ -z "$sel" ] && exit 0
target=$(printf '%s' "$sel" | cut -f1)
tmux switch-client -t "$target"
