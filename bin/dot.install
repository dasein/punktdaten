#!/usr/bin/env bash

# Links up files and dirs in my dotfiles repo to $HOME
# Clobbers links, nothing else.

root=$(dirname -- $(dirname -- $(readlink -f -- "$0")))
cd "$root" || exit

git submodule update --init

# Link a single item from the repo into a target directory, optionally
# under a different name. Replaces existing symlinks. Refuses to touch
# real files/dirs.
link_into() {
    local target_dir="$1"
    local src="$2"
    local name="${3:-$(basename "$src")}"
    local dest="$target_dir/$name"

    if [ -e "$dest" ] && [ ! -h "$dest" ]; then
        echo "ERROR: $dest is real and exists, skipping"
        return
    fi
    ln -fns "$src" "$dest"
    echo "Linked: $dest"
}

# Remove symlinks in a directory that point at repo files that no longer
# exist.
prune_links() {
    local dir="$1"
    local link
    for link in "$dir"/* "$dir"/.*; do
        if [ -h "$link" ] && [ ! -e "$link" ] && [[ "$(readlink "$link")" == "$root"/* ]]; then
            rm "$link"
            echo "Removed: $link"
        fi
    done
}

# Top-level dotfiles — exclude dirs managed file-by-file below
dotfiles=$(find . -mindepth 1 -maxdepth 1 -iname ".*" \
    ! -name .git \
    ! -name .claude \
    ! -name .codex \
    -exec basename {} \;)

for dot in $dotfiles; do
    if [ ! -e "$HOME/$dot" ] || [ -h "$HOME/$dot" ]; then
        ln -fs "$root/$dot" "$HOME"
        echo "Linked: $HOME/$dot"
    else
        echo "ERROR: $HOME/$dot is real and exists"
    fi
done

# ~/bin
mkdir -p "$HOME/bin"
binfiles=$(find ./bin -mindepth 1 -maxdepth 1 -exec basename {} \;)
for b in $binfiles; do
    if [ ! -e "$HOME/bin/$b" ] || [ -h "$HOME/bin/$b" ]; then
        ln -fs "$root/bin/$b" "$HOME/bin"
        echo "Linked: $HOME/bin/$b"
    else
        echo "ERROR: $HOME/bin/$b is real and exists"
    fi
done

# Agents — Claude and Codex share one set of instructions and skills.
# Codex reads personal skills from ~/.agents/skills.
# Settings files (settings.json, config.toml) stay local: the agents write
# machine-specific state such as trusted project paths into them.
mkdir -p "$HOME/.claude/skills" "$HOME/.agents/skills"
link_into "$HOME/.claude" "$root/.claude/CLAUDE.md"
link_into "$HOME/.codex" "$root/.claude/CLAUDE.md" AGENTS.md
for f in "$root/.claude/skills/"*; do
    link_into "$HOME/.claude/skills" "$f"
    link_into "$HOME/.agents/skills" "$f"
done

for d in "$HOME" "$HOME/bin" "$HOME/.claude" "$HOME/.claude/commands" \
    "$HOME/.claude/skills" "$HOME/.codex" "$HOME/.agents/skills"; do
    prune_links "$d"
done
